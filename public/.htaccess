# ==============================================================================
# VIXY ECOSYSTEM - MASTER .HTACCESS (CPANEL / APACHE / FEROZO / DONWEB)
# ==============================================================================

DirectoryIndex index.html index.php
Options -Indexes

# 1. ENRUTAMIENTO MOD_REWRITE
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pasar Authorization a PHP para FastCGI / PHP-FPM
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Permitir peticiones a APIs directamente
    RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/store/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/shop/backend/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/registro-comercios/api/ [NC]
    RewriteRule ^ - [L]

    # Compatibilidad: si /api/ no existe como archivo fisico, usar /store/api/
    RewriteCond %{REQUEST_URI} ^/api/(.*)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ store/api/$1 [L,QSA]

    # Reescritura para assets estaticos compartidos de Store (evita duplicar 15MB en disco)
    RewriteCond %{REQUEST_URI} ^/store/(banners|logo|payment-icons|qr|cards)/(.*)$ [NC]
    RewriteRule ^store/(banners|logo|payment-icons|qr|cards)/(.*)$ $1/$2 [L]

    # Reescritura transparente de /panel-admin/ a /panel/ (evita duplicar 21MB en disco)
    RewriteCond %{REQUEST_URI} ^/panel-admin/(.*)$ [NC]
    RewriteRule ^panel-admin/(.*)$ panel/$1 [L]

    # Reescritura para uploads de comercios y archivos cargados desde formularios
    # 1. Si se solicita /uploads/comercios/ y existe en registro-comercios/uploads/comercios/
    RewriteCond %{REQUEST_URI} ^/uploads/comercios/(.*)$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/registro-comercios/uploads/comercios/$1 -f
    RewriteRule ^uploads/comercios/(.*)$ registro-comercios/uploads/comercios/$1 [L]

    # 2. Si se solicita /uploads/comercios/ y existe en imgs-c-d/
    RewriteCond %{REQUEST_URI} ^/uploads/comercios/(.*)$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/imgs-c-d/comercios/$1 -f
    RewriteRule ^uploads/comercios/(.*)$ imgs-c-d/comercios/$1 [L]

    # 3. Si se solicita /imgs-c-d/ y no existe en raiz, servir de /shop/imgs-c-d/
    RewriteCond %{REQUEST_URI} ^/imgs-c-d/(.*)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/shop/imgs-c-d/$1 -f
    RewriteRule ^imgs-c-d/(.*)$ shop/imgs-c-d/$1 [L]

    # 4. Respaldo a prueba de 404: Si cualquier imagen solicitada en /uploads/comercios/ no existe, servir banner por defecto (evita icono roto)
    RewriteCond %{REQUEST_URI} ^/uploads/comercios/(.*)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^uploads/comercios/(.*)$ banners/banner_comercios.jpg [L]

    # Si el archivo fisico existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Si es un directorio fisico, agregar trailing slash si falta
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

    # Si el directorio tiene index.html, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rutas dinamicas de Shop (/shop/...)
    RewriteCond %{REQUEST_URI} ^/shop/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^shop/(.*)$ /shop/index.html [L]

    # Rutas dinamicas de Panel Web (/panel/...)
    RewriteCond %{REQUEST_URI} ^/panel/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^panel/(.*)$ /panel/index.html [L]

    # Rutas dinamicas de Store (/store/...)
    RewriteCond %{REQUEST_URI} ^/store/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^store/(.*)$ /store/index.html [L]
</IfModule>

# 2. CABECERA AUTHORIZATION (MOD_SETENVIF)
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "Bearer (.+)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase X-Auth-Token "(.+)" HTTP_X_AUTH_TOKEN=$1
</IfModule>

# 3. TIPOS MIME
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType application/json .json
    AddType font/woff2 .woff2
</IfModule>

# 4. CABECERAS CORS Y SEGURIDAD
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-Auth-Token"
</IfModule>
